{
  "version": 2,
  "framework": null,
  "buildCommand": "prisma generate && echo 'Static files ready'",
  "outputDirectory": "./",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/docs",  "destination": "/docs.html"  },
    { "source": "/((?!api/).*)", "destination": "/app.html" }
  ]
}
