{
  "version": 2,
  "buildCommand": "echo 'Static files ready'",
  "outputDirectory": "./",
  "functions": {
    "api/intake.js": {
      "runtime": "@vercel/node@3.0.0"
    },
    "api/personas.js": {
      "runtime": "@vercel/node@3.0.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|json))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/app.html"
    }
  ]
}