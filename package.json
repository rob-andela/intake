    "ddev": "npm run start:all",
    "vercel-dev": "vercel dev"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "serve": "^14.2.1",
    "concurrently": "^8.2.0"
  }
}

